// Copy this file to Secrets.xcconfig (gitignored) and fill in real values.

// Get the publishable key from the ColorSense Clerk dashboard (Development or Production instance).
CLERK_PUBLISHABLE_KEY = pk_test_your_key_here

// Your 10-character Apple Developer Team ID. Required only to run on a physical iPhone;
// the simulator signs locally and ignores this. A free Apple ID works — it creates a
// "Personal Team" whose ID is shown in Xcode ▸ Settings ▸ Accounts, under your Apple ID,
// in the team list. Leave blank to keep building for the simulator only.
DEVELOPMENT_TEAM =

// Optional: point at a local api-server instead of production for account-saved palettes.
// API_BASE_URL = http://localhost:3000/api

// PostHog product analytics. Project settings -> Project API key. The key is a client
// identifier by design, not a secret. Host is https:/$()/us.i.posthog.com or the EU
// equivalent. Leave both blank to build with analytics disabled.
POSTHOG_API_KEY =
POSTHOG_HOST =
