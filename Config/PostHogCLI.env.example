# Copy this file to Config/PostHogCLI.env (gitignored) and fill in real values.
#
# These credentials belong to posthog-cli, which the Release build phase runs to upload the
# dSYM. They are NOT the same as POSTHOG_API_KEY in Secrets.xcconfig: that one is the project
# API key the app ships with, a client identifier by design. POSTHOG_CLI_API_KEY is a personal
# API token that can write to the project, so it is a real secret and never committed.
#
# Create one at PostHog -> Settings -> Personal API keys, with the scopes the docs list for
# error tracking symbol-set upload. The project ID is the number in the dashboard URL.
#
# Xcode build phases do not load shell profiles, which is why this is a file rather than an
# environment variable. project.yml points POSTHOG_CLI_DOTENV_FILE at it, and posthog-cli reads
# it only when the values are not already in the environment, so CI can still inject them.
#
# Without this file, Debug builds are unaffected but a Release build fails: the upload script
# exits non-zero rather than let a release ship with no symbols to match its crashes.

POSTHOG_CLI_API_KEY =
POSTHOG_CLI_PROJECT_ID =
